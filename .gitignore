node_modules/
# Compiled by the Dockerfile's builder stage on every deploy — never committed,
# so it can never drift from the markup in the commit that ships.
public/tailwind.css
# Local in-loop browser scratch.
.playwright-mcp/
*.png
# Local in-loop run artifacts. The server log is scratch, and the lockfile is
# regenerated by every local `npm install` — the Dockerfile copies package.json
# only, so a committed lock would never be the thing the image builds from.
.server.log
package-lock.json
